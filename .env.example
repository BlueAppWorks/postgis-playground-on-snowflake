# Local development only (copy to .env.local). On App Runtime these come from app.yml.
PGHOST=xxxxxxxx.your-account.region.aws.postgres.snowflake.app
PGPORT=5432
PGDATABASE=postgis_playground
PGUSER=application
PGPASSWORD=change-me

# Optional
# BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron   # "none" = draw everything from PostGIS
# ALLOW_SQL_CONSOLE=true        # "false" disables the Try-it SQL console
# PGSSL_CA=/path/to/ca.pem      # verify the server certificate (otherwise encrypted, not verified)
# OSM_USER_AGENT=PostGIS-Playground/1.0 (you@example.com)
