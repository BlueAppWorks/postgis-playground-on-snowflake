{
  "name": "postgis-playground",
  "version": "0.1.0",
  "description": "Learn PostGIS step by step on Snowflake Postgres, deployed with Snowflake App Runtime",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start -H ${HOSTNAME:-0.0.0.0} -p ${PORT:-8080}",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "seed:build": "node scripts/build-seed.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
